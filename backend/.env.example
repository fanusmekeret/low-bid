# ─── LOW BID backend environment ───
# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
# Public URL of the API (used for Chapa callback/return URLs)
API_PUBLIC_URL=http://localhost:4000
# Comma-separated origins allowed by CORS (admin web, local Flutter web)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# MySQL 8 — utf8mb4 database
DATABASE_URL="mysql://lowbid:change-me@127.0.0.1:3306/lowbid"
# Separate database for integration tests (it is wiped by the tests)
TEST_DATABASE_URL="mysql://lowbid:change-me@127.0.0.1:3306/lowbid_test"

REDIS_URL=redis://127.0.0.1:6379
# Auction start/close jobs run inside the API by default. Set to false and run `bun run worker`
# to move them to their own process.
RUN_WORKERS=true

# Generate each with: bun -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
OTP_PEPPER=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# OTP
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_10_MIN=3

# SMS: "console" (development only — prints messages to the log) or "ethiotelecom"
SMS_PROVIDER=console
ETHIOTELECOM_SMS_URL=
ETHIOTELECOM_SMS_USERNAME=
ETHIOTELECOM_SMS_PASSWORD=
ETHIOTELECOM_SMS_SENDER_ID=LOWBID

# First super admin (staff login), created by `bun run db:seed` if missing
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

# Demo data (bun run db:seed:demo, never in production): one password shared by the demo bidder
# accounts 0900000201–0900000208. Leave empty to get a random one printed by the seed.
DEMO_USER_PASSWORD=

# File storage for product photos and private files
# local: files under STORAGE_LOCAL_DIR, served by the API at /media (fine for one VPS)
# s3:    any S3-compatible service (Backblaze B2, Wasabi, Cloudflare R2). Use two buckets:
#        a public one for product photos and a PRIVATE one for seller ID documents.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# Public URL prefix for product photos. Local default: ${API_PUBLIC_URL}/media
PUBLIC_MEDIA_BASE_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_FILE_MB=8

# Chapa (https://dashboard.chapa.co → Settings → API). Use the TEST key in development.
# The secret key never leaves this server; the app only ever sees Chapa's checkout link.
CHAPA_SECRET_KEY=
# Settings → Webhooks: set the URL to ${API_PUBLIC_URL}/api/v1/payments/chapa/webhook and
# copy the "secret hash" here.
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1
# Optional: where Chapa sends the buyer after paying (default: this API's return page)
CHAPA_RETURN_URL=
# Refuse test-mode payments (default: true in production)
CHAPA_EXPECT_LIVE=
# App link the payment return page opens
APP_DEEP_LINK=lowbid://payments
