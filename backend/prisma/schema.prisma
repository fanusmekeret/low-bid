// LOW BID — MySQL 8 schema (InnoDB, utf8mb4).
// Every money amount is BIGINT santim (1 ETB = 100 santim). No floats in money paths.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────── Identity & access ─────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              BigInt     @id @default(autoincrement())
  phone           String     @unique @db.VarChar(20)
  email           String?    @unique @db.VarChar(191)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  fullName        String     @map("full_name") @db.VarChar(120)
  locale          String     @default("en") @db.VarChar(5)
  status          UserStatus @default(ACTIVE)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.DateTime(3)
  strikes         Int        @default(0)
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until") @db.DateTime(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  roles         UserRole[]
  refreshTokens RefreshToken[]
  otpCodes      OtpCode[]
  sellerProfile SellerProfile?
  products      Product[]
  bids          Bid[]
  watchlist     AuctionWatchlist[]
  leading       Auction[]          @relation("CurrentWinner")
  results       AuctionResult[]
  payments      Payment[]
  notifications Notification[]
  devices       UserDevice[]
  auditLogs     AuditLog[]

  @@index([status])
  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(40)
  name        String           @db.VarChar(80)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    Int              @id @default(autoincrement())
  code  String           @unique @db.VarChar(60)
  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId Int    @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  familyId   String    @map("family_id") @db.Char(26)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  replacedBy BigInt?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum OtpPurpose {
  VERIFY_PHONE
  RESET_PASSWORD
}

model OtpCode {
  id         BigInt     @id @default(autoincrement())
  userId     BigInt     @map("user_id")
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.Char(64)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.DateTime(3)
  consumedAt DateTime?  @map("consumed_at") @db.DateTime(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

// ───────────── Sellers ─────────────

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model SellerProfile {
  id            BigInt               @id @default(autoincrement())
  userId        BigInt               @unique @map("user_id")
  displayName   String               @map("display_name") @db.VarChar(120)
  tin           String?              @db.VarChar(20)
  city          String?              @db.VarChar(80)
  payoutMethod  String               @default("BANK") @map("payout_method") @db.VarChar(20)
  payoutAccount Json?                @map("payout_account")
  status        ReviewStatus         @default(PENDING)
  approvedAt    DateTime?            @map("approved_at") @db.DateTime(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  user          User                 @relation(fields: [userId], references: [id])
  verifications SellerVerification[]
  payouts       SellerPayout[]

  @@index([status])
  @@map("seller_profiles")
}

model SellerVerification {
  id         BigInt        @id @default(autoincrement())
  sellerId   BigInt        @map("seller_id")
  docType    String        @map("doc_type") @db.VarChar(30)
  storageKey String        @map("storage_key") @db.VarChar(255)
  status     ReviewStatus  @default(PENDING)
  reviewedBy BigInt?       @map("reviewed_by")
  note       String?       @db.VarChar(500)
  createdAt  DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("seller_verifications")
}

// ───────────── Catalog ─────────────

model Category {
  id                  Int        @id @default(autoincrement())
  parentId            Int?       @map("parent_id")
  slug                String     @unique @db.VarChar(80)
  nameEn              String     @map("name_en") @db.VarChar(80)
  nameAm              String     @map("name_am") @db.VarChar(80)
  sortOrder           Int        @default(0) @map("sort_order")
  requiresDeposit     Boolean    @default(false) @map("requires_deposit")
  defaultDepositMinor BigInt     @default(0) @map("default_deposit_minor")
  isActive            Boolean    @default(true) @map("is_active")
  parent              Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children            Category[] @relation("CategoryTree")
  products            Product[]

  @@map("categories")
}

enum ProductCondition {
  NEW
  LIKE_NEW
  USED_GOOD
  USED_FAIR
  FOR_PARTS
}

model Product {
  id          BigInt           @id @default(autoincrement())
  sellerId    BigInt           @map("seller_id")
  categoryId  Int              @map("category_id")
  title       String           @db.VarChar(160)
  description String           @db.Text
  condition   ProductCondition
  location    String           @db.VarChar(80)
  headline    Json // up to 3 short spec strings shown on cards
  status      ReviewStatus     @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  seller      User             @relation(fields: [sellerId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  specs       ProductSpec[]
  auctions    Auction[]

  @@index([categoryId, status])
  @@index([sellerId])
  @@fulltext([title, description])
  @@map("products")
}

model ProductImage {
  id         BigInt  @id @default(autoincrement())
  productId  BigInt  @map("product_id")
  storageKey String  @map("storage_key") @db.VarChar(255)
  sortOrder  Int     @default(0) @map("sort_order")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// Full specification sheet, grouped (General, Display, Performance, Cameras, Battery,
// Connectivity, Condition and box). Prices never live here.
model ProductSpec {
  id        BigInt  @id @default(autoincrement())
  productId BigInt  @map("product_id")
  groupName String  @map("group_name") @db.VarChar(40)
  label     String  @db.VarChar(80)
  value     String  @db.VarChar(255)
  sortOrder Int     @default(0) @map("sort_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, groupName])
  @@map("product_specs")
}

// ───────────── Auctions & bids ─────────────

enum AuctionStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  LIVE
  CLOSED
  NO_SALE
  CANCELLED
}

model Auction {
  id              BigInt             @id @default(autoincrement())
  productId       BigInt             @map("product_id")
  status          AuctionStatus      @default(DRAFT)
  startPrice      BigInt             @map("start_price")
  minIncrement    BigInt             @map("min_increment")
  reservePrice    BigInt?            @map("reserve_price")
  depositMinor    BigInt             @default(0) @map("deposit_minor")
  currentPrice    BigInt?            @map("current_price")
  currentWinnerId BigInt?            @map("current_winner_id")
  bidCount        Int                @default(0) @map("bid_count")
  startsAt        DateTime           @map("starts_at") @db.DateTime(3)
  endsAt          DateTime           @map("ends_at") @db.DateTime(3)
  extensionCount  Int                @default(0) @map("extension_count")
  isFeatured      Boolean            @default(false) @map("is_featured")
  version         Int                @default(0)
  createdAt       DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  product         Product            @relation(fields: [productId], references: [id])
  currentWinner   User?              @relation("CurrentWinner", fields: [currentWinnerId], references: [id])
  bids            Bid[]
  watchers        AuctionWatchlist[]
  result          AuctionResult?

  @@index([status, endsAt])
  @@index([status, startsAt])
  @@index([productId])
  @@map("auctions")
}

model Bid {
  id             BigInt   @id @default(autoincrement())
  auctionId      BigInt   @map("auction_id")
  bidderId       BigInt   @map("bidder_id")
  amount         BigInt
  idempotencyKey String   @map("idempotency_key") @db.VarChar(64)
  ip             String?  @db.VarChar(45)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  auction        Auction  @relation(fields: [auctionId], references: [id])
  bidder         User     @relation(fields: [bidderId], references: [id])

  @@unique([auctionId, idempotencyKey])
  @@index([auctionId, amount(sort: Desc)])
  @@index([bidderId, createdAt])
  @@map("bids")
}

model AuctionWatchlist {
  userId    BigInt   @map("user_id")
  auctionId BigInt   @map("auction_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@id([userId, auctionId])
  @@map("auction_watchlists")
}

enum ResultStatus {
  AWAITING_PAYMENT
  PAID
  DEFAULTED
  NO_SALE
  COMPLETED
}

model AuctionResult {
  id              BigInt       @id @default(autoincrement())
  auctionId       BigInt       @unique @map("auction_id")
  winnerId        BigInt?      @map("winner_id")
  finalPrice      BigInt?      @map("final_price")
  status          ResultStatus
  paymentDeadline DateTime?    @map("payment_deadline") @db.DateTime(3)
  fallbackRank    Int          @default(1) @map("fallback_rank") // 1 = top bidder, 2 = next…
  closedAt        DateTime     @default(now()) @map("closed_at") @db.DateTime(3)
  auction         Auction      @relation(fields: [auctionId], references: [id])
  winner          User?        @relation(fields: [winnerId], references: [id])
  payments        Payment[]

  @@index([status, paymentDeadline])
  @@map("auction_results")
}

// ───────────── Money ─────────────

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  EXPIRED
}

model Payment {
  id          BigInt        @id @default(autoincrement())
  resultId    BigInt        @map("result_id")
  userId      BigInt        @map("user_id")
  txRef       String        @unique @map("tx_ref") @db.VarChar(64)
  amount      BigInt
  currency    String        @default("ETB") @db.Char(3)
  status      PaymentStatus @default(INITIATED)
  checkoutUrl String?       @map("checkout_url") @db.VarChar(500)
  chapaRefId  String?       @map("chapa_ref_id") @db.VarChar(64)
  verifiedAt  DateTime?     @map("verified_at") @db.DateTime(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  result      AuctionResult @relation(fields: [resultId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  commission  Commission?
  refunds     Refund[]

  @@index([status, createdAt])
  @@index([userId])
  @@map("payments")
}

model PaymentWebhook {
  id             BigInt    @id @default(autoincrement())
  provider       String    @db.VarChar(20)
  eventId        String    @map("event_id") @db.VarChar(100)
  signatureValid Boolean   @map("signature_valid")
  payload        Json
  processedAt    DateTime? @map("processed_at") @db.DateTime(3)
  receivedAt     DateTime  @default(now()) @map("received_at") @db.DateTime(3)

  @@unique([provider, eventId])
  @@map("payment_webhooks")
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

// Double-entry ledger: lines with the same group_id must sum to zero (debits = credits).
model Transaction {
  id        BigInt          @id @default(autoincrement())
  groupId   String          @map("group_id") @db.Char(26)
  account   String          @db.VarChar(60) // e.g. buyer:12, escrow, platform:revenue, seller:7
  direction LedgerDirection
  amount    BigInt
  memo      String?         @db.VarChar(255)
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  @@index([groupId])
  @@index([account, createdAt])
  @@map("transactions")
}

model Commission {
  id        BigInt   @id @default(autoincrement())
  paymentId BigInt   @unique @map("payment_id")
  rateBps   Int      @map("rate_bps") // 1000 = 10%
  amount    BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  payment   Payment  @relation(fields: [paymentId], references: [id])

  @@map("commissions")
}

enum MoneyOutStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
}

model Refund {
  id          BigInt         @id @default(autoincrement())
  paymentId   BigInt         @map("payment_id")
  amount      BigInt
  reason      String         @db.VarChar(255)
  status      MoneyOutStatus @default(REQUESTED)
  externalRef String?        @map("external_ref") @db.VarChar(100)
  processedBy BigInt?        @map("processed_by")
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  payment     Payment        @relation(fields: [paymentId], references: [id])

  @@index([status])
  @@map("refunds")
}

model SellerPayout {
  id          BigInt         @id @default(autoincrement())
  sellerId    BigInt         @map("seller_id")
  paymentId   BigInt?        @map("payment_id")
  amount      BigInt
  status      MoneyOutStatus @default(REQUESTED)
  method      String         @db.VarChar(20)
  externalRef String?        @map("external_ref") @db.VarChar(100)
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  seller      SellerProfile  @relation(fields: [sellerId], references: [id])

  @@index([sellerId, status])
  @@map("seller_payouts")
}

// ───────────── Notifications, audit, settings ─────────────

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(500)
  data      Json?
  readAt    DateTime? @map("read_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model UserDevice {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  fcmToken  String   @unique @map("fcm_token") @db.VarChar(255)
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   BigInt?  @map("actor_id")
  action    String   @db.VarChar(60)
  entity    String   @db.VarChar(40)
  entityId  String   @map("entity_id") @db.VarChar(40)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(80)
  value     Json
  updatedBy BigInt?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("system_settings")
}
