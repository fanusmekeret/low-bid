// LOW BID — Prisma schema (MySQL 8, InnoDB, utf8mb4)
// Money: every amount is BIGINT in santim (1 ETB = 100 santim). Never use floats.
// Run from backend/: bun run db:push (development) — see backend/README.md

generator client {
  provider = "prisma-client-js"
  // Generate into the backend's node_modules, where the API's @prisma/client looks. Without this,
  // Prisma picks the first @prisma/client it finds walking up from this folder (e.g. one in the
  // repo root), and the API keeps using an out-of-date client.
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Locale {
  en
  am
}

enum OtpPurpose {
  VERIFY_PHONE
  RESET_PASSWORD
  LOGIN
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductCondition {
  NEW
  LIKE_NEW
  USED_GOOD
  USED_FAIR
  FOR_PARTS
}

enum ProductStatus {
  DRAFT    // being written by LOW BID staff
  APPROVED // published: can be auctioned
  ARCHIVED
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  CLOSED
  CANCELLED
}

enum AuctionOutcome {
  SOLD
  NO_BIDS
  NOT_ENOUGH_BIDS // fewer paid bids than the auction's minimum; every bid fee is refunded
}

enum ResultStatus {
  AWAITING_PAYMENT
  PAID
  PAYMENT_EXPIRED
  OFFERED_TO_NEXT
  FULFILLED
  DISPUTED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  CHAPA
}

enum PaymentPurpose {
  WINNING_BID
  BID_FEE // the fee paid to place one bid
}

/// A bid counts only once its fee is paid. Amounts stay secret until the auction closes.
enum BidStatus {
  PENDING_PAYMENT // fee checkout started
  ACTIVE          // fee verified: the bid takes part in the draw for lowest unique bid
  VOID            // fee not paid (failed or expired) or paid too late (refunded)
}

// Double-entry accounts. EXTERNAL is the world outside LOW BID (buyers paying in,
// sellers and refunds paid out). Money moving from A to B = CREDIT A + DEBIT B.
enum LedgerAccount {
  EXTERNAL
  ESCROW
  PLATFORM_REVENUE
  PROVIDER_FEES
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum RefundStatus {
  REQUESTED  // buyer asked; waits for an admin
  APPROVED   // ready to send (automatic refunds start here)
  PROCESSING // accepted by Chapa, not yet confirmed
  PROCESSED  // money returned (or recorded as returned manually)
  REJECTED
  FAILED     // Chapa refused or reversed; needs an admin
}

enum RefundKind {
  BID_FEE_REFUND  // fee paid after bidding closed, or the auction was cancelled or did not reach its minimum bids
  SALE_REFUND     // admin or approved buyer request
  LATE_PAYMENT    // paid after the offer expired or went to another bidder
}



enum NotificationType {
  BID_CONFIRMED
  AUCTION_WON
  AUCTION_LOST
  AUCTION_ENDING_SOON
  AUCTION_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REMINDER
  REFUND_ISSUED
  PAYMENT_EXPIRED
  SECOND_CHANCE_OFFER
  ITEM_DELIVERED  // LOW BID handed over or delivered the item
  SYSTEM
}

// ───────────────────────── Users & access ─────────────────────────

model User {
  id               BigInt     @id @default(autoincrement())
  phone            String     @unique @db.VarChar(20) // E.164, e.g. +2519XXXXXXXX
  email            String?    @unique @db.VarChar(191)
  passwordHash     String     @map("password_hash") @db.VarChar(255)
  firstName        String     @map("first_name") @db.VarChar(80)
  lastName         String     @map("last_name") @db.VarChar(80)
  avatarUrl        String?    @map("avatar_url") @db.VarChar(500)
  locale           Locale     @default(en)
  status           UserStatus @default(ACTIVE)
  phoneVerifiedAt  DateTime?  @map("phone_verified_at") @db.DateTime(3)
  paymentStrikes   Int        @default(0) @map("payment_strikes")
  lastLoginAt      DateTime?  @map("last_login_at") @db.DateTime(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  roles            UserRole[]
  refreshTokens    RefreshToken[]
  otpCodes         OtpCode[]
  devices          UserDevice[]
  sellerProfile    SellerProfile?
  bids             Bid[]
  watchlist        AuctionWatchlist[]
  leadingAuctions  Auction[]        @relation("AuctionCurrentWinner")
  wonResults       AuctionResult[]  @relation("ResultWinner")
  payments         Payment[]
  refundsRequested Refund[]         @relation("RefundRequestedBy")
  refundsReviewed  Refund[]         @relation("RefundReviewedBy")
  notifications    Notification[]
  auditLogs        AuditLog[]
  settingsUpdated  SystemSetting[]

  @@index([status])
  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50) // guest, buyer, bidder, seller, auction_admin, super_admin
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(80) // e.g. bid:place, auction:approve
  description String?          @db.VarChar(255)

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     BigInt   @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  assignedBy BigInt?  @map("assigned_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         BigInt    @id @default(autoincrement())
  userId     BigInt    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64) // sha256 hex
  familyId   String    @map("family_id") @db.Char(26)          // ULID; whole family revoked on reuse
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ip         String?   @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  replacedBy BigInt?   @map("replaced_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpCode {
  id         BigInt     @id @default(autoincrement())
  userId     BigInt?    @map("user_id")
  phone      String     @db.VarChar(20)
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.Char(64)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.DateTime(3)
  consumedAt DateTime?  @map("consumed_at") @db.DateTime(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose, createdAt])
  @@map("otp_codes")
}

model UserDevice {
  id         BigInt         @id @default(autoincrement())
  userId     BigInt         @map("user_id")
  fcmToken   String         @unique @map("fcm_token") @db.VarChar(255)
  platform   DevicePlatform
  appVersion String?        @map("app_version") @db.VarChar(20)
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.DateTime(3)
  createdAt  DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_devices")
}

// ───────────────────────────── Sellers ─────────────────────────────

/// LOW BID itself is the only seller: one "house" profile owns every product. Kept as a table so
/// listings keep an owner (shown as "Sold by LOW BID") and the model can grow later.
model SellerProfile {
  id                BigInt       @id @default(autoincrement())
  userId            BigInt       @unique @map("user_id")
  businessName      String       @map("business_name") @db.VarChar(150)
  businessType      String       @default("INDIVIDUAL") @map("business_type") @db.VarChar(30) // INDIVIDUAL | COMPANY
  tinNumber         String?      @map("tin_number") @db.VarChar(20)
  city              String       @db.VarChar(80)
  address           String?      @db.VarChar(255)
  bio               String?      @db.Text
  status            SellerStatus @default(PENDING)
  approvedAt        DateTime?    @map("approved_at") @db.DateTime(3)
  ratingAvg         Int          @default(0) @map("rating_avg") // x100, e.g. 465 = 4.65
  ratingCount       Int          @default(0) @map("rating_count")
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  products      Product[]

  @@index([status])
  @@map("seller_profiles")
}


// ──────────────────────── Catalog & products ────────────────────────

model Category {
  id        Int       @id @default(autoincrement())
  parentId  Int?      @map("parent_id")
  slug      String    @unique @db.VarChar(100)
  nameEn    String    @map("name_en") @db.VarChar(100)
  nameAm    String    @map("name_am") @db.VarChar(100)
  iconKey   String?   @map("icon_key") @db.VarChar(60)
  defaultBidFee BigInt @default(0) @map("default_bid_fee") // santim; 0 = use the platform default (settings auction.lowestUniqueBid)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id              BigInt           @id @default(autoincrement())
  sellerId        BigInt           @map("seller_id")
  categoryId      Int              @map("category_id")
  title           String           @db.VarChar(200)
  description     String           @db.Text
  condition       ProductCondition
  location        String           @db.VarChar(120)
  attributes      Json?            // category-specific: { "year": 2016, "mileage_km": 85000 }
  status          ProductStatus    @default(DRAFT)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  seller   SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  auctions Auction[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@fulltext([title, description])
  @@map("products")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  key       String   @db.VarChar(300) // object-storage base key; sizes: _sm, _md, _lg .webp
  width     Int
  height    Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ───────────────────────────── Auctions ─────────────────────────────

/// Lowest unique bid auction: each bid costs a fee, amounts stay secret until the end, and
/// the lowest amount that exactly one person bid wins. If no amount is unique, the lowest
/// amount wins and, among those, the bid whose fee was confirmed first.
model Auction {
  id                 BigInt        @id @default(autoincrement())
  productId          BigInt        @map("product_id")
  status             AuctionStatus @default(SCHEDULED)
  itemCost           BigInt        @map("item_cost")       // santim; what the item costs LOW BID (for reporting: fees + winning bid vs cost)
  marketValue        BigInt?       @map("market_value")    // santim; retail value shown to bidders
  bidFee             BigInt        @map("bid_fee")         // santim; paid through Chapa for every bid
  minBid             BigInt        @default(1) @map("min_bid") // santim; lowest amount a bid may be (default 0.01 ETB)
  maxBid             BigInt        @map("max_bid")         // santim; highest amount a bid may be
  bidStep            BigInt        @default(1) @map("bid_step") // santim; amounts must be a multiple of this
  minPaidBids        Int           @default(0) @map("min_paid_bids") // fewer paid bids at the close → no sale, fees refunded
  maxBidsPerUser     Int           @default(50) @map("max_bids_per_user")
  currentWinnerId    BigInt?       @map("current_winner_id") // set at the close (and on a second-chance offer); never during bidding
  bidCount           Int           @default(0) @map("bid_count") // paid (ACTIVE) bids only
  startsAt           DateTime      @map("starts_at") @db.DateTime(3)
  endsAt             DateTime      @map("ends_at") @db.DateTime(3)
  isFeatured         Boolean       @default(false) @map("is_featured")
  viewCount          Int           @default(0) @map("view_count")
  approvedById       BigInt?       @map("approved_by")
  approvedAt         DateTime?     @map("approved_at") @db.DateTime(3)
  cancelledReason    String?       @map("cancelled_reason") @db.VarChar(500)
  cancelledById      BigInt?       @map("cancelled_by")
  closedAt           DateTime?     @map("closed_at") @db.DateTime(3)
  version            Int           @default(0)
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  product       Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  currentWinner User?              @relation("AuctionCurrentWinner", fields: [currentWinnerId], references: [id], onDelete: SetNull)
  bids          Bid[]
  watchers      AuctionWatchlist[]
  result        AuctionResult?

  @@index([status, endsAt])
  @@index([status, startsAt])
  @@index([isFeatured, status])
  @@index([productId])
  @@map("auctions")
}

model Bid {
  id             BigInt    @id @default(autoincrement())
  auctionId      BigInt    @map("auction_id")
  bidderId       BigInt    @map("bidder_id")
  amount         BigInt    // santim; secret until the auction closes
  status         BidStatus @default(PENDING_PAYMENT)
  paymentId      BigInt?   @unique @map("payment_id") // the bid fee
  activatedAt    DateTime? @map("activated_at") @db.DateTime(3) // fee verified; breaks ties when no amount is unique
  idempotencyKey String    @map("idempotency_key") @db.VarChar(64)
  ip             String?   @db.VarChar(45)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  auction Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  bidder  User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([auctionId, idempotencyKey])
  @@index([auctionId, status, amount])
  @@index([auctionId, bidderId, amount])
  @@index([bidderId, createdAt])
  @@map("bids")
}

model AuctionWatchlist {
  userId    BigInt   @map("user_id")
  auctionId BigInt   @map("auction_id")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@id([userId, auctionId])
  @@index([auctionId])
  @@map("auction_watchlists")
}

model AuctionResult {
  id              BigInt         @id @default(autoincrement())
  auctionId       BigInt         @unique @map("auction_id")
  outcome         AuctionOutcome
  status          ResultStatus   @default(AWAITING_PAYMENT)
  winnerId        BigInt?        @map("winner_id")
  winningBidId    BigInt?        @map("winning_bid_id")
  finalPrice      BigInt?        @map("final_price")     // santim
  buyerPremium    BigInt         @default(0) @map("buyer_premium")
  totalDue        BigInt?        @map("total_due")
  offerRank       Int            @default(1) @map("offer_rank") // 1 = top bidder, 2 = second chance offer, …
  offerHistory    Json?          @map("offer_history") // earlier winners who did not pay
  paymentDeadline DateTime?      @map("payment_deadline") @db.DateTime(3)
  paidAt          DateTime?      @map("paid_at") @db.DateTime(3)
  fulfilledAt     DateTime?      @map("fulfilled_at") @db.DateTime(3) // LOW BID delivered or handed over the item
  confirmedAt     DateTime?      @map("confirmed_at") @db.DateTime(3) // the winner confirmed receipt (closes refund requests)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  auction  Auction   @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  winner   User?     @relation("ResultWinner", fields: [winnerId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([winnerId, status])
  @@index([status, paymentDeadline])
  @@map("auction_results")
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id            BigInt          @id @default(autoincrement())
  txRef         String          @unique @map("tx_ref") @db.VarChar(64) // LB-<auctionId>-<ulid>
  purpose       PaymentPurpose  @default(WINNING_BID)
  auctionId     BigInt?         @map("auction_id")
  resultId      BigInt?         @map("result_id") // set when purpose = WINNING_BID
  userId        BigInt          @map("user_id")
  provider      PaymentProvider @default(CHAPA)
  amount        BigInt          // santim, set by server
  currency      String          @default("ETB") @db.Char(3)
  status        PaymentStatus   @default(INITIATED)
  checkoutUrl   String?         @map("checkout_url") @db.VarChar(500)
  providerRef   String?         @map("provider_ref") @db.VarChar(100) // Chapa ref_id
  providerFee   BigInt?         @map("provider_fee")
  paymentMethod String?         @map("payment_method") @db.VarChar(40) // telebirr, cbebirr, card…
  failureReason String?         @map("failure_reason") @db.VarChar(500)
  verifyPayload Json?           @map("verify_payload") // last raw verify response
  verifiedAt    DateTime?       @map("verified_at") @db.DateTime(3)
  expiresAt     DateTime        @map("expires_at") @db.DateTime(3)
  receiptNo     String?         @unique @map("receipt_no") @db.VarChar(30)
  refundedAmount BigInt         @default(0) @map("refunded_amount")
  lastCheckedAt DateTime?       @map("last_checked_at") @db.DateTime(3)
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  result       AuctionResult?   @relation(fields: [resultId], references: [id], onDelete: Restrict)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  bid          Bid?             // set when purpose = BID_FEE
  webhooks     PaymentWebhook[]
  transactions Transaction[]
  refunds      Refund[]

  @@index([resultId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([auctionId, userId])
  @@map("payments")
}

model PaymentWebhook {
  id             BigInt          @id @default(autoincrement())
  provider       PaymentProvider @default(CHAPA)
  eventKey       String          @map("event_key") @db.VarChar(150) // provider event id or `${tx_ref}:${status}`
  paymentId      BigInt?         @map("payment_id")
  txRef          String?         @map("tx_ref") @db.VarChar(64)
  signatureValid Boolean         @map("signature_valid")
  payload        Json
  headers        Json?
  processedAt    DateTime?       @map("processed_at") @db.DateTime(3)
  processError   String?         @map("process_error") @db.VarChar(1000)
  receivedAt     DateTime        @default(now()) @map("received_at") @db.DateTime(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, eventKey])
  @@index([txRef])
  @@map("payment_webhooks")
}

// Double-entry ledger: every money movement writes ≥2 rows with the same groupId whose debits = credits.
model Transaction {
  id          BigInt          @id @default(autoincrement())
  groupId     String          @map("group_id") @db.Char(26) // ULID
  paymentId   BigInt?         @map("payment_id")
  refundId    BigInt?         @map("refund_id")
  account     LedgerAccount
  direction   LedgerDirection
  amount      BigInt          // santim, always positive
  currency    String          @default("ETB") @db.Char(3)
  memo        String?         @db.VarChar(255)
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  payment Payment?      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  refund  Refund?       @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([account, createdAt])
  @@index([paymentId])
  @@map("transactions")
}


model Refund {
  id             BigInt       @id @default(autoincrement())
  paymentId      BigInt       @map("payment_id")
  kind           RefundKind
  reference      String       @unique @db.VarChar(64) // ours, sent to Chapa so a retry never refunds twice
  amount         BigInt
  reason         String       @db.VarChar(500)
  status         RefundStatus @default(REQUESTED)
  providerRef    String?      @map("provider_ref") @db.VarChar(100) // Chapa ref_id
  providerStatus String?      @map("provider_status") @db.VarChar(30)
  failureReason  String?      @map("failure_reason") @db.VarChar(500)
  attempts       Int          @default(0)
  requestedById  BigInt?      @map("requested_by") // null = automatic
  reviewedById   BigInt?      @map("reviewed_by")
  reviewedAt     DateTime?    @map("reviewed_at") @db.DateTime(3)
  processedAt    DateTime?    @map("processed_at") @db.DateTime(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  payment      Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy  User?         @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy   User?         @relation("RefundReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}


// ─────────────────────── Notifications & ops ───────────────────────

model Notification {
  id        BigInt           @id @default(autoincrement())
  userId    BigInt           @map("user_id")
  type      NotificationType
  titleEn   String           @map("title_en") @db.VarChar(150)
  titleAm   String           @map("title_am") @db.VarChar(150)
  bodyEn    String           @map("body_en") @db.VarChar(500)
  bodyAm    String           @map("body_am") @db.VarChar(500)
  data      Json?            // { auctionId, txRef, … } for deep links
  readAt    DateTime?        @map("read_at") @db.DateTime(3)
  pushedAt  DateTime?        @map("pushed_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Banner {
  id        Int       @id @default(autoincrement())
  titleEn   String    @map("title_en") @db.VarChar(150)
  titleAm   String    @map("title_am") @db.VarChar(150)
  imageKey  String    @map("image_key") @db.VarChar(300)
  linkType  String    @default("NONE") @map("link_type") @db.VarChar(20) // NONE | AUCTION | CATEGORY | URL
  linkValue String?   @map("link_value") @db.VarChar(300)
  startsAt  DateTime? @map("starts_at") @db.DateTime(3)
  endsAt    DateTime? @map("ends_at") @db.DateTime(3)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([isActive, sortOrder])
  @@map("banners")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   BigInt?  @map("actor_id")
  action    String   @db.VarChar(80)  // e.g. auction.approve, payment.reconcile
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  requestId String?  @map("request_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedById BigInt?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}
